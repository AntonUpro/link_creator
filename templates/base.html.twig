<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}QuickLink — Сервис коротких ссылок{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🔗</text></svg>">

    <!-- Подключение стилей -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/footer.css') }}">

    {% block stylesheets %}

    {% endblock %}
</head>
<body>
<!-- Навигация -->
<nav class="navbar">
    <div class="container">
        <a href="{{ path('app_home') }}" class="logo">
            <i class="fas fa-link"></i>
            <span>Quick<span class="logo-accent">Link</span></span>
        </a>
        <div class="nav-links">
            <a href="{{ path('app_home') }}"><i class="fas fa-home"></i> Главная</a>
            <a href="{{ path('app_dashboard') }}"><i class="fas fa-chart-bar"></i> Статистика</a>
            <a href="#features"><i class="fas fa-star"></i> Возможности</a>
            <a href="#api"><i class="fas fa-code"></i> API</a>
            {% if app.user %}
                <a href="{{ path('app_logout') }}" class="btn-outline"><i class="fas fa-sign-out-alt"></i> Выйти</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn-outline"><i class="fas fa-sign-in-alt"></i> Войти</a>
            {% endif %}
        </div>
        <button class="menu-toggle">
            <i class="fas fa-bars"></i>
        </button>
    </div>
</nav>

<!-- Основной контент -->
<main>
    {% block body %}{% endblock %}
</main>

<!-- Футер -->
<footer>
    <div class="container">
        <div class="footer-content">
            <div class="footer-section">
                <h3><i class="fas fa-link"></i> QuickLink</h3>
                <p>Создавайте, управляйте и отслеживайте короткие ссылки. Быстро, просто, бесплатно.</p>
            </div>
            <div class="footer-section">
                <h4>Инструменты</h4>
                <a href="#">Сокращение ссылки</a>
                <a href="#">QR-код</a>
                <a href="#">Аналитика</a>
            </div>
            <div class="footer-section">
                <h4>Компания</h4>
                <a href="#">О нас</a>
                <a href="#">Контакты</a>
                <a href="#">Условия</a>
            </div>
            <div class="footer-section">
                <h4>Контакты</h4>
                <p><i class="fas fa-envelope"></i> hello@quicklink.ru</p>
                <div class="social">
                    <a href="#"><i class="fab fa-telegram"></i></a>
                    <a href="#"><i class="fab fa-vk"></i></a>
                    <a href="#"><i class="fab fa-github"></i></a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© {{ "now"|date("Y") }} QuickLink. Все права защищены.</p>
            <p>Сделано с <i class="fas fa-heart" style="color: #ff4757;"></i> для интернета</p>
        </div>
    </div>
</footer>

<!-- Скрипты -->
<script src="https://cdn.jsdelivr.net/npm/clipboard@2.0.11/dist/clipboard.min.js"></script>
{% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    <script>
        // Мобильное меню
        document.querySelector('.menu-toggle').addEventListener('click', () => {
            document.querySelector('.nav-links').classList.toggle('active');
        });

        // Инициализация Clipboard.js
        new ClipboardJS('.copy-btn');

        // Показ уведомлений
        function showNotification(message, type = 'success') {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.innerHTML = `
                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                    <span>${message}</span>
                    <button onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
                `;
            document.body.appendChild(notification);
            setTimeout(() => notification.remove(), 5000);
        }

        // Обработка копирования
        document.addEventListener('click', (e) => {
            if (e.target.closest('.copy-btn')) {
                showNotification('Ссылка скопирована в буфер обмена!');
            }
        });
    </script>
{% endblock %}
</body>
</html>
