        // Обновление данных на странице
        function updatePageData(data) {
            // Обновляем статус
            const statusBadge = document.querySelector('.status-badge');
            if (statusBadge && data.is_active !== undefined) {
                statusBadge.className = 'status-badge ' +
                    (data.is_active ? 'status-active' : 'status-inactive') +
                    (data.is_expired ? ' status-expired' : '');

                statusBadge.innerHTML = '<i class="fas fa-' +
                    (data.is_active ? (data.is_expired ? 'clock' : 'check-circle') : 'ban') +
                    '"></i> ' +
                    (data.is_active ? (data.is_expired ? 'Истекла' : 'Активна') : 'Неактивна');
            }

            // Обновляем дату истечения если есть
            if (data.expires_at) {
                const expiresElement = document.querySelector('.stat-item:nth-child(4) .stat-value');
                if (expiresElement) {
                    expiresElement.textContent = new Date(data.expires_at).toLocaleDateString('ru-RU');
                    if (data.is_expired) {
                        expiresElement.classList.add('text-danger');
                    } else {
                        expiresElement.classList.remove('text-danger');
                    }
                }
            }

            // Обновляем дату обновления
            const updatedElement = document.querySelector('.stat-item:nth-child(3) .stat-value');
            if (updatedElement && data.updated_at) {
                updatedElement.textContent = new Date(data.updated_at).toLocaleDateString('ru-RU');
            }
        }

        // Показать ошибку валидации
        function showError(input, message) {
            // Удаляем старые ошибки
            const existingError = input.parentNode.querySelector('.error-message');
            if (existingError) {
                existingError.remove();
            }

            // Добавляем новую ошибку
            const errorDiv = document.createElement('div');
            errorDiv.className = 'error-message';
            errorDiv.style.color = '#ef4444';
            errorDiv.style.fontSize = '14px';
            errorDiv.style.marginTop = '5px';
            errorDiv.innerHTML = '<i class="fas fa-exclamation-circle"></i> ' + message;

            input.parentNode.appendChild(errorDiv);
        }

        // Сброс статистики
        function resetStats() {
            const linkId = document.getElementById('editLinkForm').dataset.id;

            fetch(`/dashboard/links/${linkId}/reset-stats`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showNotification('Статистика успешно сброшена!', 'success');
                        closeResetStatsModal();

                        // Обновляем счетчик кликов на странице
                        const clicksElement = document.querySelector('.stat-item:nth-child(1) .stat-value');
                        if (clicksElement) {
                            clicksElement.textContent = '0';
                        }

                        // Обновляем в форме если она еще открыта
                        const form = document.getElementById('editLinkForm');
                        if (form) {
                            form.dataset.clicks = '0';
                        }
                    } else {
                        showNotification(data.error || 'Ошибка при сбросе статистики', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Произошла ошибка', 'error');
                });
        }

        // Удаление ссылки
        function deleteLink() {
            const linkId = document.getElementById('editLinkForm').dataset.id;

            fetch(`/dashboard/links/${linkId}/delete`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showNotification('Ссылка успешно удалена!', 'success');
                        closeDeleteModal();

                        // Перенаправляем на dashboard через 1 секунду
                        setTimeout(() => {
                            window.location.href = '{{ path('app_dashboard') }}';
                        }, 1000);
                    } else {
                        showNotification(data.error || 'Ошибка при удалении', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Произошла ошибка', 'error');
                });
        }

        // Уведомления
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = 'notification';
            notification.innerHTML = `
            <div style="position: fixed; top: 20px; right: 20px; background: ${type === 'success' ? '#10b981' : type === 'error' ? '#ef4444' : '#3b82f6'};
                         color: white; padding: 15px 25px; border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.15);
                         z-index: 9999; display: flex; align-items: center; gap: 10px; animation: slideIn 0.3s ease-out;">
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i>
                <span>${message}</span>
                <button onclick="this.parentElement.parentElement.remove()" style="margin-left: 15px; background: none; border: none; color: white; cursor: pointer;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        `;

            document.body.appendChild(notification);

            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 5000);
        }

        // Анимация уведомлений
        const style = document.createElement('style');
        style.textContent = `
        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
    `;
        document.head.appendChild(style);
    </script>
{% endblock %}
