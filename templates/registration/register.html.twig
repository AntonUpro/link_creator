{% extends 'base.html.twig' %}

{% block title %}Регистрация — QuickLink{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auth-register-form.css') }}">
{% endblock %}

{% block body %}
<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h1>Создайте аккаунт</h1>
            <p class="subtitle">Зарегистрируйтесь, чтобы получить доступ к расширенным возможностям</p>

            <div class="shortener-card">
                {{ form_start(registration_form) }}
                    <div class="input-group">
                        <div class="form-group">
                            {{ form_label(registration_form.email) }}
                            {{ form_widget(registration_form.email, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(registration_form.email) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(registration_form.password.first) }}
                            {{ form_widget(registration_form.password.first, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(registration_form.password.first) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(registration_form.password.second) }}
                            {{ form_widget(registration_form.password.second, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(registration_form.password.second) }}
                        </div>

                        <button type="submit" class="btn-primary">
                            <i class="fas fa-user-plus"></i> Зарегистрироваться
                        </button>
                    </div>
                {{ form_end(registration_form) }}

                <div class="auth-options">
                    <p>Или войдите через:</p>
                    <a href="{{ path('oauth_connect', {'provider': 'yandex'}) }}" class="btn-secondary">
                        <img src="{{ asset('image/yandex_logo_ru.svg') }}" alt="Yandex">
                    </a>
                </div>

                <div class="auth-switch">
                    <p>Уже есть аккаунт? <a href="{{ path('app_login') }}">Войти</a></p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
