{% extends 'base.html.twig' %}

{% block title %}Вход — QuickLink{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auth-register-form.css') }}">
{% endblock %}

{% block body %}
<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h1>Вход в аккаунт</h1>
            <p class="subtitle">Войдите, чтобы получить доступ к вашему профилю и ссылкам</p>

            <div class="shortener-card">
                <form method="post">
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    {% if app.user %}
                        <div class="mb-3">
                            Вы вошли как {{ app.user.userIdentifier }} - <a href="{{ path('app_logout') }}">Выйти</a>
                        </div>
                    {% endif %}

                    <div class="input-group">
                        <div class="form-group">
                            <label for="inputEmail">Email</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" required autofocus autocomplete="email">
                        </div>

                        <div class="form-group">
                            <label for="inputPassword">Пароль</label>
                            <input type="password" name="_password" id="inputPassword" class="form-control" required autocomplete="current-password">
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn-primary">
                            <i class="fas fa-sign-in-alt"></i> Войти
                        </button>
                    </div>
                </form>

                <div class="auth-options">
                    <p>Или войдите через:</p>
                    <a href="{{ path('oauth_connect', {'provider': 'yandex'}) }}" class="btn-secondary">
                        <img src="{{ asset('image/yandex_logo_ru.svg') }}" alt="Yandex">
                    </a>
                </div>

                <div class="auth-switch">
                    <p>Нет аккаунта? <a href="{{ path('app_register') }}">Зарегистрироваться</a></p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
