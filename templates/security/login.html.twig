{% extends 'base.html.twig' %}

{% block title %}Вход — QuickLink{% endblock %}

{% block body %}
<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h1>Вход в аккаунт</h1>
            <p class="subtitle">Войдите, чтобы получить доступ к вашему профилю и ссылкам</p>

            <div class="shortener-card">
                <form method="post">
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    {% if app.user %}
                        <div class="mb-3">
                            Вы вошли как {{ app.user.userIdentifier }} - <a href="{{ path('app_logout') }}">Выйти</a>
                        </div>
                    {% endif %}

                    <div class="input-group">
                        <div class="form-group">
                            <label for="inputEmail">Email</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" required autofocus autocomplete="email">
                        </div>

                        <div class="form-group">
                            <label for="inputPassword">Пароль</label>
                            <input type="password" name="_password" id="inputPassword" class="form-control" required autocomplete="current-password">
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn-primary">
                            <i class="fas fa-sign-in-alt"></i> Войти
                        </button>
                    </div>
                </form>

                <div class="auth-options">
                    <p>Или войдите через:</p>
                    <a href="{{ path('oauth_connect', {'provider': 'yandex'}) }}" class="btn-secondary">
                        <i class="fab fa-yandex"></i> Yandex
                    </a>
                </div>

                <div class="auth-switch">
                    <p>Нет аккаунта? <a href="{{ path('app_register') }}">Зарегистрироваться</a></p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: var(--dark);
        }

        .form-control {
            width: 100%;
            padding: 12px 18px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            transition: all 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
        }

        .form-error {
            color: var(--danger);
            font-size: 0.85rem;
            margin-top: 5px;
        }

        .auth-options {
            text-align: center;
            margin: 25px 0;
            padding-top: 25px;
            border-top: 1px solid var(--border);
        }

        .auth-options .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
        }

        .auth-switch {
            text-align: center;
            margin-top: 25px;
        }

        .auth-switch a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
        }

        .auth-switch a:hover {
            text-decoration: underline;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            padding: 12px 18px;
            border-radius: var(--radius-sm);
            margin-bottom: 20px;
            border: 1px solid #f5c6cb;
        }
    </style>
{% endblock %}
